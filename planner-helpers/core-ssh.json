      "stats": {"positionals": [{"pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,252}"}, {"pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,127}"}], "options": {}},
      "processes": {"positionals": [{"pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,252}"}, {"pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,127}"}], "options": {}},
      "system-info": {"positionals": [{"pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,252}"}], "options": {}},
