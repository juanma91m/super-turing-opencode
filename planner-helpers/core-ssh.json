      "connections": {"positionals": [{"pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,252}"}], "options": {}},
      "addresses": {"positionals": [{"pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,252}"}], "options": {}},
      "routes": {"positionals": [{"pattern": "[A-Za-z0-9][A-Za-z0-9_.-]{0,252}"}], "options": {}},
