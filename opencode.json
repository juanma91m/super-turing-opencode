{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "opencode debug config*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "bash scripts/sync-opencode-stack.sh*": "allow",
      "bash \"scripts/sync-opencode-stack.sh\"*": "allow",
      "bash scripts/install-opencode-stack.sh*": "allow",
      "bash \"scripts/install-opencode-stack.sh\"*": "allow"
    }
  }
}
